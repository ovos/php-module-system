{
  "name": "ovos/php-module-system",
  "description": "The system administration module for ovos/php-library applications: cache control, database migrations, a test and benchmark runner, session and log housekeeping, error pages, encryption utilities and profiler helpers.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/ovos/php-module-system",
  "type": "library",
  "authors": [
    {
      "name": "Marcin Gil",
      "email": "mg@ovos.at"
    }
  ],
  "require" : {
    "php": ">=8.3"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Components\\": "application/components",
      "Controllers\\": "application/controllers",
      "Locales\\": "application/locales",
      "Plugins\\": "application/plugins",
      "Widgets\\": "application/widgets",
      "Models\\": "application/models",
      "Stores\\": "application/stores"
    }
  },
  "scripts": {
    "php:version":
    [
      "php -v"
    ]
  }
}
