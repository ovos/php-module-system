<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Profiler</title>
		<base href="<?= SYSTEM_PATH; ?>">
		
		<link rel="icon" type="image/svg+xml" href="favicon.svg">
		<link rel="alternate icon" href="favicon.ico">
		
		<?php /* optional project-supplied head extras (webfonts, meta …):
			a project ships application/views/layouts/partials/profiler-head.phtml
			and this standalone page picks it up through the module include path —
			absent = no-op. Rendered before theme.css, mirroring the font-then-theme
			order of a project's own layout. */ ?>
		<?php $profilerHead = stream_resolve_include_path('layouts/partials/profiler-head.phtml'); ?>
		<?php if($profilerHead !== false): ?>
		<?= $this->render($profilerHead); ?>
		<?php endif; ?>
		<?php /* the theme: the directory under public/themes/ named by the
			`theme` config key. It used to be the vendor, and for most
			projects those are the same word — but the vendor names the
			INSTALLATION, so the two come apart as soon as one instance is
			called something else (the console's instance is 'ovos', its
			theme is 'console'). A project without the key keeps the old
			convention, so nothing has to be touched to keep its theme.
			Linked only when the file is really there: filemtime() on a
			missing asset raises a reported error, and a reported error
			replaces the whole document with the error view. */ ?>
		<?php $theme = $this->asset('themes/'
			. ($this->config->theme ?? $this->config->vendor) . '/theme.css'); ?>
		<?php if(is_file($theme->getFilename())): ?>
		<link href="<?= $theme; ?>" rel="stylesheet" />
		<?php endif; ?>
	</head>
	<body class="profiler-page">
		<ovos-profiler mode="full" stream-url="<?= $this->streamUrl; ?>" clear-url="<?= $this->clearUrl; ?>"></ovos-profiler>
		<script src="<?= SYSTEM_PATH; ?>profiler/asset"></script>
	</body>
</html>
