<?php use Ovos\Application; ?>
<?php use Ovos\Terminal\Highlighter; ?>
<?php use Ovos\Terminal\Table; ?>
<?php use Ovos\Stream\Request; ?>

<?php if($this->interface === Application::INT_HTTP): ?>
	
	<?php /*
	<?= $this->render('helpers/profiler.phtml'); ?>
	*/ ?>
	
	<div class="profiler-table profiler-requests">
		
		<div class="row">
			<div class="cell header">Requests (<?= count($this->requests); ?>)</div>
			<div class="cell header">Time</div>
			<div class="cell header">Memory</div>
		</div>
		
		<?php foreach($this->requests as $request): ?>
			<?php /** @var Request $request */ ?>
			<div class="row">
				<div class="cell"><?= $request->getMethod(); ?> <?= $request->getUrl(); ?><?php /*<?= wordwrap($request->getUrl(), 100, PHP_EOL); ?>*/ ?></div>
				<div class="cell"><?= $request->getMeasurement()->getTotalTime(); ?></div>
				<div class="cell"><?= $request->getMeasurement()->getTotalMemory(); ?></div>
			</div>
		<?php endforeach; ?>
	</div>
	
<?php else: ?>
<?php /* Do not add an indent above as it will be displayed as a leading space before the table */
		$table = new Table;
		$table->hasMarkup((bool)$this->markup)
			->setHeaders([
				Highlighter::header('Requests ('. count($this->requests) .')'),
				Highlighter::header('Time'),
				Highlighter::header('Memory'),
			])
			->setAlignments([
				1 => Table::ALIGN_RIGHT,
				2 => Table::ALIGN_RIGHT,
			]);
		
		foreach($this->requests as $request)
		{
			/** @var Request $request */
			$table->addRow([
				'<cyan>' . $request->getMethod() . '<reset> '
					. wordwrap($request->getUrl(), 150, PHP_EOL),
				// a whole request, so the per-query scale would flag everything
				Highlighter::time($request->getMeasurement()->getTotalTime(), 0.5, 2.0),
				Highlighter::memory($request->getMeasurement()->getTotalMemory(), 8388608, 33554432),
			]);
			$table->addRow([PHP_EOL]);
		}
		
		echo PHP_EOL . $table->getTable();
	?>
<?php endif; ?>
