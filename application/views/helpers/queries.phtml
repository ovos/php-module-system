<?php use Ovos\Application; ?>
<?php use Ovos\Terminal\Highlighter; ?>
<?php use Ovos\Terminal\Table; ?>

<?php if($this->interface === Application::INT_HTTP): ?>
	
	<?php /*
	<?= $this->render('helpers/profiler.phtml'); ?>
	*/ ?>
	
	<div class="profiler-table profiler-queries">
		
		<div class="row">
			<div class="cell header">Queries (<?= count($this->queries); ?>)</div>
			<div class="cell header">Time</div>
			<div class="cell header">Memory</div>
		</div>
		
		<?php foreach($this->queries as $query): ?>
			<div class="row">
				<?php // bound values can carry user input — escape ?>
				<div class="cell"><?= $this->escape((string)$query->sql); ?></div>
				<div class="cell"><?= $query->time; ?></div>
				<div class="cell"><?= $query->memory; ?></div>
			</div>
		<?php endforeach; ?>
	</div>
	
<?php else: ?>
<?php /* Do not add an indent above as it will be displayed as a leading space before the table */
		$table = new Table;
		$table->hasMarkup((bool)$this->markup)
			->setHeaders([
				Highlighter::header('Queries (last ' . count($this->queries) . ')'),
				Highlighter::header('Time'),
				Highlighter::header('Memory'),
			])
			->setAlignments([
				1 => Table::ALIGN_RIGHT,
				2 => Table::ALIGN_RIGHT,
			]);

		foreach($this->queries as $query)
		{
			$table->addRow([
				// wrap first: the markup tokens are invisible in the terminal
				// but would count toward wordwrap()'s column budget
				Highlighter::sql(wordwrap($query->sql, 150, PHP_EOL)),
				Highlighter::time($query->time),
				Highlighter::memory($query->memory),
			]);
			$table->addRow([PHP_EOL]);
		}

		echo PHP_EOL . $table->getTable();
	?>
<?php endif; ?>
