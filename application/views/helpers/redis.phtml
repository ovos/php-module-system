<?php use Ovos\Application; ?>
<?php use Ovos\Terminal\Formatter; ?>
<?php use Ovos\Terminal\Highlighter; ?>
<?php use Ovos\Terminal\Table; ?>

<?php if($this->interface === Application::INT_HTTP): ?>
	
	<div class="profiler-table profiler-redis">
		
		<div class="row">
			<div class="cell header">Redis (<?= count($this->commands); ?>)</div>
			<div class="cell header">Time</div>
			<div class="cell header">Memory</div>
		</div>
		
		<?php foreach($this->commands as $command): ?>
			<div class="row">
				<?php // command args can carry user input (e.g. FT.SEARCH terms) —
					// handleMarkupHtml escapes every segment between the tags ?>
				<div class="cell"><?= Formatter::handleMarkupHtml(
					Highlighter::redis((string)$command->call),
				); ?></div>
				<div class="cell"><?= Formatter::handleMarkupHtml(
					Highlighter::time((string)$command->time),
				); ?></div>
				<div class="cell"><?= Formatter::handleMarkupHtml(
					Highlighter::memory((string)$command->memory),
				); ?></div>
			</div>
		<?php endforeach; ?>
	</div>
	
<?php else: ?>
<?php /* Do not add an indent above as it will be displayed as a leading space before the table */
		$table = new Table;
		$table->hasMarkup((bool)$this->markup)
			->setHeaders([
				Highlighter::header('Redis (last ' . count($this->commands) . ')'),
				Highlighter::header('Time'),
				Highlighter::header('Memory'),
			])
			->setAlignments([
				1 => Table::ALIGN_RIGHT,
				2 => Table::ALIGN_RIGHT,
			]);

		foreach($this->commands as $command)
		{
			$table->addRow([
				// wrap first: the markup tokens are invisible in the terminal
				// but would count toward wordwrap()'s column budget
				Highlighter::redis(wordwrap($command->call, 150, PHP_EOL)),
				Highlighter::time($command->time),
				Highlighter::memory($command->memory),
			]);
			$table->addRow([PHP_EOL]);
		}

		echo PHP_EOL . $table->getTable();
	?>
<?php endif; ?>
