<?php use Ovos\Application; ?>
<?php use Ovos\Terminal\Highlighter; ?>
<?php use Ovos\Terminal; ?>
<?php use Ovos\Terminal\Table; ?>
<?php use Ovos\Measurement; ?>

<?php if($this->interface === Application::INT_HTTP): ?>
	
	<?= $this->render('helpers/profiler.phtml'); ?>
	
	<div class="profiler-table profiler-benchmark">
		
		<div class="row">
			<div class="cell header auto">Marker (<?= count($this->measurements); ?>)</div>
			<div class="cell header">Time</div>
			<div class="cell header">Memory</div>
		</div>
		
		<?php foreach($this->measurements as $marker => $measurement): ?>
			<?php /** @var Measurement $measurement */ ?>
			
			<div class="row">
				<div class="cell auto"><?= $marker; ?></div>
				<div class="cell"><?= $measurement->getTotalTime(); ?></div>
				<div class="cell"><?= $measurement->getTotalMemory(); ?></div>
			</div>
		<?php endforeach; ?>
	</div>
	
	<div class="profiler profiler-tools">
		<a class="profiler-tool clear-cache" target="_blank" href="tools/clear-cache">Clear cache</a>
		<a class="profiler-tool collapse">Collapse</a>
	</div>
	
<?php else: ?>
<?php /* Do not add an indent above as it will be displayed as a leading space before the table */
		$table = new Table;
		$table->setHeaders([
			Highlighter::header('Requests (' . count($this->measurements) . ')'),
			Highlighter::header('Time'),
			Highlighter::header('Memory'),
		]);
		$table->setAlignments([
			1 => Table::ALIGN_RIGHT,
			2 => Table::ALIGN_RIGHT,
		]);
		
		foreach($this->measurements as $marker => $measurement)
		{
			/** @var Measurement $measurement */
			$table->addRow([
				Highlighter::color(wordwrap($marker, 150, PHP_EOL), 'cyan'),
				// a whole run, so the per-query scale would flag everything
				Highlighter::time($measurement->getTotalTime(), 1.0, 5.0),
				Highlighter::memory($measurement->getTotalMemory(), 8388608, 33554432),
			]);
			$table->addRow([PHP_EOL]);
		}
		
		echo PHP_EOL . Terminal::getMessage($table->getTable(), (bool)$this->markup);
	?>
<?php endif; ?>
