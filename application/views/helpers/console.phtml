<?php use Ovos\Application; ?>
<?php use Ovos\Terminal\Highlighter; ?>
<?php use Ovos\Terminal\Table; ?>

<?php if($this->interface === Application::INT_HTTP): ?>
	
	<div class="profiler-table profiler-console">
		
		<div class="row">
			<div class="cell header">Messages (<?= count($this->messages); ?>)</div>
			<div class="cell header">Time</div>
			<div class="cell header">Memory</div>
		</div>
		
		<?php foreach($this->messages as $message): ?>
			<div class="row">
				<div class="cell"><?= is_string($message->message) ? $message->message : print_r($message->message, true); ?></div>
				<div class="cell"><?= $message->time; ?></div>
				<div class="cell"><?= $message->memory; ?></div>
			</div>
		<?php endforeach; ?>
	</div>
	
<?php else: ?>
<?php /* Do not add an indent above as it will be displayed as a leading space before the table */
		$table = new Table;
		$table->hasMarkup((bool)$this->markup)
			->setHeaders([
				Highlighter::header('Messages (last ' . count($this->messages) . ')'),
				Highlighter::header('Time'),
				Highlighter::header('Memory'),
			])
			->setAlignments([
				1 => Table::ALIGN_RIGHT,
				2 => Table::ALIGN_RIGHT,
			]);
		
		foreach($this->messages as $message)
		{
			$table->addRow([
				// a console message is arbitrary data — sanitize, or a payload
				// carrying <red> paints itself now that markup is on
				Highlighter::sanitize(wordwrap($message->message, 150, PHP_EOL)),
				// a call over the network, so seconds are the scale
				Highlighter::time($message->time, 0.25, 1.0),
				Highlighter::memory($message->memory),
			]);
			$table->addRow([PHP_EOL]);
		}
		
		echo PHP_EOL . $table->getTable();
	?>
<?php endif; ?>
